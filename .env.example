APP_ENV=development
DATABASE_URL=postgresql+psycopg://job_agent:job_agent@localhost:5432/job_agent
OPENAI_API_KEY=
LOG_LEVEL=INFO

# Phase 4.2 health alert configuration (enable after testing)
DISCOVERY_HEALTH_ALERTS_ENABLED=false
DISCOVERY_HEALTH_FAILURE_THRESHOLD=2
DISCOVERY_HEALTH_STALE_HOURS=12

# Phase 4.1 scheduled discovery / notifications
SCHEDULED_DISCOVERY_MINIMUM_SCORE=80
# disabled | console | pushover
NOTIFICATION_PROVIDER=disabled
NOTIFICATION_MAX_ATTEMPTS=3
# Register a Pushover application at https://pushover.net/apps/build
# Obtain the user key from https://pushover.net/
PUSHOVER_API_TOKEN=
PUSHOVER_USER_KEY=
# Optional: target only this named device (omit to send to all active devices).
PUSHOVER_DEVICE=
